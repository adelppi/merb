{
  "expo": {
    "name": "merb",
    "slug": "merb",
    "version": "0.1.0",
    "scheme": "merb",
    "orientation": "portrait",
    "platforms": ["ios"],
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/merb.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.adelppi.merb"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-sigma.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f2f2f7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
