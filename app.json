{
  "expo": {
    "name": "merb",
    "slug": "merb",
    "version": "1.0.0",
    "scheme": "merb",
    "orientation": "portrait",
    "platforms": ["ios"],
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/merb.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.adelppi.merb",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-sigma.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f2f2f7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7e8fc0d8-815b-44db-a387-defcdbc3ce89"
      }
    },
    "owner": "adelppi"
  }
}
