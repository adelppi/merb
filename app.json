{
  "expo": {
    "name": "merb",
    "slug": "merb",
    "version": "0.1.0",
    "scheme": "merb",
    "orientation": "portrait",
    "platforms": ["ios"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "plugins": ["expo-router", "expo-asset", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
